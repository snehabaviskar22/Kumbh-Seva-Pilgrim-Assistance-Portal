# =============================================================================
# Spring Boot Backend .gitignore
# =============================================================================

# --- Maven Build Outputs ---
HELP.md
target/
build/
*.class
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- Sensitive Files & Credentials ---
.env
.env.*
*.key
*.pem
*.jks
*.p12
application-local.properties
application-secret.properties
*secret*
*credential*

# --- Runtime Uploads ---
uploads/*
!uploads/.gitkeep

# --- STS / Eclipse ---
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# --- IntelliJ IDEA ---
.idea
*.iws
*.iml
*.ipr

# --- NetBeans ---
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- VS Code ---
.vscode/

# --- Logs ---
*.log
logs/

# --- OS Artifacts ---
Thumbs.db
.DS_Store
