# =============================================================================
# Frontend Client .gitignore
# =============================================================================

# --- Environment & Sensitive Config ---
.env
.env.*
*.env
*secret*
*credential*

# --- Node / Package Managers ---
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build & Bundler Dist ---
dist/
build/
.cache/
.parcel-cache/

# --- Editor & OS Junk ---
.vscode/
.idea/
*.sublime-*
.DS_Store
Thumbs.db
[Dd]esktop.ini

# --- Local Logs & Backups ---
*.log
*.bak
