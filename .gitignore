# =============================================================================
# KumbhSeva - Master .gitignore
# Prevents sensitive credentials, environment variables, build artifacts, 
# uploads, and system caches from being committed to Git.
# =============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*secret*
*credential*
application-local.properties
application-secret.properties
secrets/
credentials.json
auth.json

# --- Database Dumps & Backups ---
*.dump
*.sql.bak
*.bak
*.backup

# --- Uploaded Media & User Content ---
uploads/*
!uploads/.gitkeep
demo/uploads/*
!demo/uploads/.gitkeep

# --- Java & Maven Build Outputs ---
target/
build/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- IDEs & Editor Configuration ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.springBeans
.sts4-cache
.apt_generated
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Node & Frontend Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Logs & Runtime Temp Files ---
*.log
logs/
*.pid
*.seed
*.pid.lock
tmp/
temp/

# --- Operating System Caches ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
