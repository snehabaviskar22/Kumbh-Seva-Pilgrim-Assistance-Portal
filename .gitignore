
# =============================================================================
# KumbhSeva - Master .gitignore
# Prevents sensitive credentials, environment variables, build artifacts,
# uploads, and system caches from being committed to Git.
# =============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*secret*
*credential*
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml
application-dev.properties
application-dev.yml
secrets/
credentials.json
auth.json

# --- Database Dumps & Backups ---
*.dump
*.sql.bak
*.bak
*.backup

# --- Uploaded Media & User Content ---
uploads/*
!uploads/.gitkeep
demo/uploads/*
!demo/uploads/.gitkeep

# --- Java Compiled Files & Build Outputs ---
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
target/
build/
out/
!**/src/main/**/target/
!**/src/test/**/target/

# --- Maven Wrapper ---
# Keep mvnw, mvnw.cmd, and .mvn/wrapper/maven-wrapper.properties
# Ignore the downloaded wrapper JAR if you prefer not to commit it
.mvn/wrapper/maven-wrapper.jar

# --- IDEs & Editor Configuration ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.springBeans
.sts4-cache
.apt_generated
.factorypath
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Node & Frontend Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Frontend Build Outputs ---
# Keep these ignored if generated by your build tools
dist/
coverage/

# --- Logs & Runtime Temporary Files ---
*.log
logs/
*.pid
*.seed
*.pid.lock
tmp/
temp/
*.tmp
*.swp

# --- OS Files & Caches ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
